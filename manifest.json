{
  "manifest_version": 3,
  "name": "scfix",
  "version": "2.0.0",
  "description": "A calmer SoundCloud: an editorial redesign with a live scope visualizer, light and dark themes, and shuffle that covers your whole library.",
  "homepage_url": "https://github.com/defakof/scfix",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["app.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["app.css"],
      "matches": ["https://soundcloud.com/*"]
    }
  ]
}
